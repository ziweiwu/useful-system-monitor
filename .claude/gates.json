{
  "watch": [
    "src/",
    "test/",
    "scripts/",
    "package.json",
    "package-lock.json",
    "tsconfig.json",
    "tsconfig.build.json",
    "vitest.config.ts",
    ".oxlintrc.json"
  ],
  "gates": [
    ["lint", ["npm", "run", "lint"]],
    ["typecheck", ["npm", "run", "typecheck"]],
    ["test", ["npx", "vitest", "run", "--exclude", "test/ui.test.tsx", "--exclude", "**/node_modules/**", "--exclude", "**/dist/**"]],
    ["build", ["npm", "run", "build"]]
  ],
  "timeout": 600
}
